<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h1 class="h3 mb-3">MedVault</h1>
          <p class="text-muted mb-4">
            Plataforma para la gestión de ficha clínica electrónica: pacientes, atenciones y documentos asociados.
          </p>

          <div class="d-flex gap-2 flex-wrap">
            <% if (user && user.userId) { %>
              <a href="/user" class="btn btn-primary">Ir al inicio de usuario</a>
              <a href="/logout" class="btn btn-outline-danger">Cerrar sesión</a>
            <% } else { %>
              <a href="/login" class="btn btn-primary">Iniciar sesión</a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
