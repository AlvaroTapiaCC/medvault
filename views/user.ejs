<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm">
        <div class="card-body p-4">
          <h1 class="h3 mb-3">MedVault</h1>
          <p class="text-muted mb-4">Bienvenido, <strong><%= user.email %></strong>. Selecciona una opción para continuar.</p>

          <div class="list-group mb-4">
            <a href="/patient?view=patients" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
              <span>📋 Listar pacientes</span>
              <span class="text-muted">Ver y gestionar fichas</span>
            </a>
            <a href="/patient?view=createPatient" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
              <span>➕ Registrar nuevo paciente</span>
              <span class="text-muted">Crear ficha clínica</span>
            </a>
          </div>

          <div class="d-flex justify-content-end">
            <a href="/logout" class="btn btn-outline-danger">Cerrar sesión</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
