<div id="app"></div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const { html, render } = window.litHtml;
    const appContainer = document.getElementById('app');
    const patientId = '<%= patientId %>';

    const state = {
      patient: null,
      patientRecords: [],
      patientDocuments: [],
      selectedRecordId: null,
      editingNotes: false,
      notesDraft: '',
      documentsVisible: false,
      documentsLoaded: false,
      message: '',
      messageType: ''
    };

    function formatDate(value) {
      if (!value) return '-';
      return String(value).split('T')[0];
    }

    const template = (state) => html`
      <div class="container-fluid mt-4">
        <div class="row mb-4">
          <div class="col-md-6">
            <h1>MedVault - Detalle de Paciente</h1>
            <p class="text-muted">Usuario: <%= user.email %></p>
          </div>
          <div class="col-md-6 text-end">
            <a href="/user" class="btn btn-outline-primary me-2">Inicio</a>
            <a href="/logout" class="btn btn-danger">Cerrar Sesión</a>
          </div>
        </div>

        ${state.message ? html`
          <div class="alert alert-${state.messageType || 'info'}" role="alert">
            ${state.message}
          </div>
        ` : ''}

        ${state.patient ? renderPatientDetailView(state) : html`
          <div class="alert alert-secondary">Cargando ficha clínica...</div>
        `}
      </div>
    `;

    function renderPatientDetailView(state) {
      const patient = state.patient;
      const selectedRecord = state.patientRecords.find(record => record.record_id === state.selectedRecordId);

      return html`
        <div class="row">
          <div class="col-md-12 mb-3">
            <div class="d-flex gap-2 flex-wrap">
              <a href=${`/patient/${patient.patient_id}/new-record`} class="btn btn-warning btn-sm">Registrar nueva atención</a>
              <a href=${`/patient/${patient.patient_id}/new-document`} class="btn btn-primary btn-sm">Subir documento</a>
            </div>
          </div>
          <div class="col-md-12">
            <div class="card">
              <div class="card-header bg-info text-white">
                <h5 class="mb-0">Ficha Clínica del Paciente</h5>
              </div>
              <div class="card-body">
                <div class="row">
                  <div class="col-md-6">
                    <p><strong>Nombre:</strong> ${patient.full_name}</p>
                    <p><strong>RUT/ID:</strong> ${patient.national_id}</p>
                    <p><strong>Fecha Nacimiento:</strong> ${formatDate(patient.birth_date)}</p>
                    <p><strong>Aseguradora:</strong> ${patient.insurance}</p>
                  </div>
                  <div class="col-md-6">
                    <p><strong>Teléfono:</strong> ${patient.phone || '-'}</p>
                    <p><strong>Dirección:</strong> ${patient.address || '-'}</p>
                    ${state.editingNotes ? html`
                      <div class="mb-2">
                        <label class="form-label mb-1"><strong>Notas:</strong></label>
                        <textarea
                          class="form-control form-control-sm"
                          rows="3"
                          .value=${state.notesDraft}
                          @input=${(e) => { state.notesDraft = e.target.value; }}
                        ></textarea>
                        <div class="mt-2 d-flex gap-2">
                          <button @click=${saveNotes} class="btn btn-sm btn-success">Guardar notas</button>
                          <button @click=${cancelEditNotes} class="btn btn-sm btn-outline-secondary">Cancelar</button>
                        </div>
                      </div>
                    ` : html`
                      <p class="mb-1"><strong>Notas:</strong> ${patient.notes || '-'}</p>
                      <button @click=${startEditNotes} class="btn btn-sm btn-outline-info">Editar notas</button>
                    `}
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="row mt-4">
          <div class="col-md-12">
            <div class="card">
              <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">Historial de Atenciones</h5>
              </div>
              <div class="card-body">
                ${state.patientRecords.length > 0 ? html`
                  <div class="table-responsive">
                    <table class="table table-sm">
                      <thead>
                        <tr>
                          <th>Fecha</th>
                          <th>Doctor</th>
                          <th>Acciones</th>
                        </tr>
                      </thead>
                      <tbody>
                        ${state.patientRecords.map(record => html`
                          <tr>
                            <td>${formatDate(record.visit_date)}</td>
                            <td>${record.doctor_name || record.doctor_id}</td>
                            <td>
                              <button
                                @click=${() => toggleRecordDetail(record.record_id)}
                                class="btn btn-sm btn-outline-secondary"
                              >
                                ${state.selectedRecordId === record.record_id ? 'Ocultar detalle' : 'Ver detalle'}
                              </button>
                            </td>
                          </tr>
                        `)}
                      </tbody>
                    </table>
                  </div>
                  ${selectedRecord ? html`
                    <div class="alert alert-light border mt-3 mb-0">
                      <h6 class="mb-2">Detalle de atención (${formatDate(selectedRecord.visit_date)})</h6>
                      <p class="mb-2"><strong>Diagnóstico:</strong> ${selectedRecord.diagnosis}</p>
                      <p class="mb-0"><strong>Observaciones:</strong> ${selectedRecord.observations || '-'}</p>
                    </div>
                  ` : ''}
                ` : html`
                  <div class="alert alert-secondary">No hay atenciones registradas.</div>
                `}
              </div>
            </div>
          </div>
        </div>
        <div class="row mt-4">
          <div class="col-md-7">
            <div class="card">
              <div class="card-header bg-dark text-white">
                <h5 class="mb-0">Documentos Asociados</h5>
              </div>
              <div class="card-body">
                <button @click=${() => toggleDocuments(patient.patient_id)} class="btn btn-outline-dark btn-sm mb-3">
                  ${state.documentsVisible ? 'Ocultar documentos' : 'Mostrar documentos'}
                </button>

                ${state.documentsVisible ? html`
                  ${state.patientDocuments.length > 0 ? html`
                    <div class="table-responsive">
                      <table class="table table-sm table-hover">
                        <thead>
                          <tr>
                            <th>Título</th>
                            <th>Archivo</th>
                            <th>Acciones</th>
                          </tr>
                        </thead>
                        <tbody>
                          ${state.patientDocuments.map(doc => html`
                            <tr>
                              <td>${doc.title}</td>
                              <td>${doc.filename}</td>
                              <td>
                                <a class="btn btn-sm btn-outline-secondary me-1"
                                   href=${`/patient/${patient.patient_id}/document/${doc.doc_id}`}>
                                  Ver contenido
                                </a>
                                <a class="btn btn-sm btn-outline-primary"
                                   href=${`/patients/${patient.patient_id}/documents/${doc.doc_id}/download`}>
                                  Descargar
                                </a>
                              </td>
                            </tr>
                          `)}
                        </tbody>
                      </table>
                    </div>
                  ` : html`
                    <div class="alert alert-secondary mb-0">No hay documentos asociados a este paciente.</div>
                  `}
                ` : html`
                  <p class="text-muted mb-0">Haz click en “Mostrar documentos” para desplegar los documentos asociados.</p>
                `}
              </div>
            </div>
          </div>
        </div>
      `;
    }

    function update() {
      render(template(state), appContainer);
    }

    function toggleRecordDetail(recordId) {
      state.selectedRecordId = state.selectedRecordId === recordId ? null : recordId;
      update();
    }

    function startEditNotes() {
      state.editingNotes = true;
      state.notesDraft = state.patient?.notes || '';
      update();
    }

    function cancelEditNotes() {
      state.editingNotes = false;
      state.notesDraft = state.patient?.notes || '';
      update();
    }

    async function saveNotes() {
      try {
        const response = await axios.patch(`/patients/${patientId}/notes`, {
          notes: state.notesDraft
        });

        if (response.data?.patient) {
          state.patient.notes = response.data.patient.notes;
        }

        state.editingNotes = false;
        state.message = 'Notas actualizadas correctamente';
        state.messageType = 'success';
      } catch (error) {
        state.message = 'Error al actualizar notas del paciente';
        state.messageType = 'danger';
      }

      update();
    }

    async function toggleDocuments(patientId) {
      state.documentsVisible = !state.documentsVisible;

      if (state.documentsVisible && !state.documentsLoaded) {
        await loadPatientDocuments(patientId);
      } else {
        update();
      }
    }

    async function loadPatient() {
      try {
        const response = await axios.get(`/patients/${patientId}`);
        state.patient = response.data;
      } catch (error) {
        state.message = 'Error al cargar ficha del paciente';
        state.messageType = 'danger';
      }
      update();
    }

    async function loadPatientRecords() {
      try {
        const response = await axios.get(`/patients/${patientId}/records`);
        state.patientRecords = response.data || [];
      } catch (error) {
        state.message = 'Error al cargar atenciones clínicas';
        state.messageType = 'danger';
      }
      update();
    }

    async function loadPatientDocuments() {
      try {
        const response = await axios.get(`/patients/${patientId}/documents`);
        state.patientDocuments = response.data || [];
        state.documentsLoaded = true;
      } catch (error) {
        state.message = 'Error al cargar documentos del paciente';
        state.messageType = 'danger';
      }
      update();
    }

    update();
    loadPatient();
    loadPatientRecords();
  });
</script>
